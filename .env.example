# StudyGenAI — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file to version control.
#
# MINIMUM REQUIRED: Only GROQ_API_KEY is needed to run the full app.
# All IBM variables are OPTIONAL — leave them as-is if you don't have IBM credentials.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_DEBUG=false
PORT=5000

# ── Groq API (REQUIRED) ───────────────────────────────────────────────────────
# Get your free API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Available models for your account:
#   qwen/qwen3.8-27b   ← recommended (best quality)
#   qwen/qwen3.6-27b
#   groq/compound
#   groq/compound-mini
GROQ_MODEL=groq/compound

# ── IBM watsonx.ai (OPTIONAL — leave as placeholders if not available) ────────
# If these are left as placeholders, the app uses Groq for everything.
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_SPACE_ID=your_ibm_space_id_here_optional

# Cloud region: us-south | eu-de | eu-gb | jp-tok | au-syd
IBM_REGION=us-south

# watsonx.ai model ID
IBM_WX_MODEL=ibm/granite-13b-instruct-v2

# ── IBM Langflow / IBM Orchestrate (OPTIONAL) ─────────────────────────────────
# Leave as placeholders if not available.
IBM_LANGFLOW_URL=your_langflow_url_here
IBM_LANGFLOW_TOKEN=your_langflow_bearer_token_here
